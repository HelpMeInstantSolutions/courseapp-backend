# Deny direct HTTP web access to database and token files
<FilesMatch "\.(sqlite|sqlite-journal|sqlite-wal|sqlite-shm|json|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
